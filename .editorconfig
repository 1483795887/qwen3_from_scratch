# EditorConfig：VSCode（1.88+ 内置）与 PyCharm（内置）通用
# 统一缩进、行尾与字符集；代码风格细节由 ruff / clang-format 负责
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4
max_line_length = 79

# C++ / CUDA，与 .clang-format 保持一致
[*.{c,cc,cpp,cxx,cuh,cu,h,hpp}]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{json,yml,yaml,toml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
